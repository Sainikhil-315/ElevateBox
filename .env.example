# ==== Telephony (Twilio) ====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Outbound dial target.
# DEV / TESTING: your personal number below — safe to test freely.
# PRODUCTION (founder's number): set ONLY at final submission, never during build/test.
CALL_TARGET_NUMBER=7093647471

# ==== LLM (OpenRouter) ====
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# ==== Speech-to-text (Deepgram) ====
DEEPGRAM_API_KEY=

# ==== Text-to-speech (Google Cloud) ====
# Option A (simplest): API key from console -> Credentials -> API key (restricted to TTS API)
GOOGLE_TTS_API_KEY=
# Option B: service-account JSON path
GOOGLE_APPLICATION_CREDENTIALS=
TTS_LANGUAGE_EN=en-IN
TTS_LANGUAGE_HI=hi-IN
TTS_LANGUAGE_TE=te-IN

# ==== WhatsApp (Meta Cloud API) ====
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ==== Candidate / applicant ====
APPLICANT_MOBILE_NUMBER=7093647471

# ==== Backend ====
PUBLIC_WEBHOOK_URL=
PORT=8000
DATABASE_URL=sqlite:///./calls.db
ENABLE_MEDIA_STREAM=false
