# ==== Telephony (Twilio) ====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Outbound dial target.
# DEV / TESTING: your personal number below — safe to test freely.
# PRODUCTION (founder's number): set ONLY at final submission, never during build/test.
CALL_TARGET_NUMBER=

# ==== LLM ====
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1  + OPENROUTER_API_KEY
# Gemini free: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  + GEMINI_API_KEY
LLM_PROVIDER=groq
OPENROUTER_API_KEY=

# Groq (fast, free — use for dev/testing)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Gemini (fallback option)
GEMINI_API_KEY=
GEMINI_MODEL=google/gemini-2.5-flash-lite:free
GEMINI_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (production, once you're paying)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_TIMEOUT_FIRST_TOKEN=3.0
OPENROUTER_MODEL=gemini-3.5-flash-lite

# ==== Speech-to-text (Deepgram) ====
DEEPGRAM_API_KEY=
DEEPGRAM_LANGUAGE=multi

# ==== Text-to-speech (Google Cloud) ====
# Option A (simplest): API key from console -> Credentials -> API key (restricted to TTS API)
GOOGLE_TTS_API_KEY=
# Option B: service-account JSON path
GOOGLE_APPLICATION_CREDENTIALS=   # path to service-account JSON
TTS_LANGUAGE_EN=en-IN
TTS_LANGUAGE_HI=hi-IN
TTS_LANGUAGE_TE=te-IN

# ==== WhatsApp (Meta Cloud API) ====
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=          # any random string; set same value in Meta webhook config

# ==== Candidate / applicant ====
APPLICANT_MOBILE_NUMBER=+917093647471
APPLICANT_NAME=Sai Nikhil Mullapudi
RESUME_URL=https://raw.githubusercontent.com/Sainikhil-315/ElevateBox/master/docs/Resume.pdf
ARCHITECTURE_IMAGE_URL=        # public URL to architecture image (sent in final WhatsApp)

# ==== Backend ====
PUBLIC_WEBHOOK_URL=https://appliance-acceptable-webmaster-ooo.trycloudflare.com      
PORT=8000
DATABASE_URL=sqlite:///./calls.db
ENABLE_MEDIA_STREAM=true

LLM_REASONING_EFFORT=low
